# Public frontend configuration only. Never place secrets here.
# Empty API base URL uses the Vite dev proxy (same origin) → /api → backend.

VITE_API_BASE_URL=
VITE_OIDC_ISSUER=http://localhost:8080/realms/php-dev
VITE_OIDC_CLIENT_ID=php-healthcare-web
VITE_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login
VITE_OIDC_SCOPE=openid profile
VITE_OIDC_AUDIENCE=php-api

# Optional. Discovery end_session_endpoint is used when omitted.
# VITE_OIDC_END_SESSION_URL=
# VITE_OIDC_SILENT_REDIRECT_URI=http://localhost:3000/oidc-silent-renew.html
