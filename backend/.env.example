# Copy to .env for local development. Never commit .env.
# All values below are synthetic placeholders.

APP_NAME=patient-health-platform
APP_ENV=local
APP_DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
OPENAPI_ENABLED=true

# Application DML role — not a superuser, not a migrator.
DATABASE_URL=postgresql+asyncpg://app_dml:app_dml_dev_only@localhost:5433/php_dev

# Used only by explicit Alembic commands, never by application startup.
DATABASE_MIGRATION_URL=postgresql+asyncpg://php_admin:php_admin_dev_only@localhost:5433/php_dev

REDIS_URL=redis://localhost:6380/0

# Host-side only (uvicorn on the host). Docker Compose backend uses http://minio:9000.
OBJECT_STORAGE_ENDPOINT=http://localhost:9101
OBJECT_STORAGE_BUCKET=php-dev-private
OBJECT_STORAGE_ACCESS_KEY=minio_dev_access
OBJECT_STORAGE_SECRET_KEY=minio_dev_secret
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_USE_SSL=false

# OIDC / JWT validation. Replace with a real IdP in later waves.
AUTH_ISSUER=http://localhost:8080/realms/php-dev
AUTH_AUDIENCE=php-api
AUTH_JWKS_URL=
# HS256 is allowed only when APP_ENV is local, test, or development.
AUTH_DEV_HS256_SECRET=dev-only-not-for-production-change-me-32b

CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_PER_MINUTE=120
